local ThemeObjects = {} -- {obj=Instance, prop=string, role=string}

local function themed(obj, prop, role)
	table.insert(ThemeObjects, { obj = obj, prop = prop, role = role })
	return obj
end

local function applyTheme()
	local t = Themes[State.Theme] or Themes.Dark
	for _, e in ipairs(ThemeObjects) do
		local c = (e.role == "accent") and State.Accent or t[e.role]
		if c then safe(function() e.obj[e.prop] = c end) end
	end
end

---------------------------------------------------------------------
--  helpers
---------------------------------------------------------------------
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			pcall(function() inst[k] = v end)
		end
	end
	if parent then
		inst.Parent = parent
	elseif props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(inst, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, inst)
	return inst
end

local function stroke(inst, color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function padding(inst, p)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, p),
		PaddingBottom = UDim.new(0, p),
		PaddingLeft = UDim.new(0, p),
		PaddingRight = UDim.new(0, p),
	}, inst)
end

local function tween(obj, props, speed)
	local dur = (State.AnimSpeed) * (speed or 1)
	local t = TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function viewportScale()
	local cam = Workspace.CurrentCamera
	if not cam then return 1 end
	local vp = cam.ViewportSize
	local s = math.min(vp.X / 1280, vp.Y / 720)
	return math.clamp(s, 0.75, 1.35)
end

---------------------------------------------------------------------
--  character access
---------------------------------------------------------------------
local function getChar()
	local char = LocalPlayer.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	return char, hum, hrp
end

local function alive(plr)
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local Friends, Enemies = {}, {}
local PriorityRank = {}

local function refreshPriority()
	PriorityRank = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local rank = 3
		if Enemies[plr] then rank = 0
		elseif Friends[plr] then rank = 9 end
		PriorityRank[plr] = rank
	end
end

local function validTarget(plr)
	if plr == LocalPlayer then return false end
	if Friends[plr] then return false end
	if Flags.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
		return false
	end
	return alive(plr)
end

local function getTargets(range)
	local out = {}
	local char, hum, hrp = getChar()
	if not hrp then return out end
	for _, plr in ipairs(Players:GetPlayers()) do
		if validTarget(plr) then
			local thrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if thrp then
				local dist = (thrp.Position - hrp.Position).Magnitude
				if dist <= range then
					table.insert(out, { plr = plr, hrp = thrp, dist = dist })
				end
			end
		end
	end
	local mode = State.Priority
	table.sort(out, function(a, b)
		local ra = PriorityRank[a.plr] or 3
		local rb = PriorityRank[b.plr] or 3
		if ra ~= rb then return ra < rb end
		if mode == "Health" then
			local ha = a.plr.Character and a.plr.Character:FindFirstChildOfClass("Humanoid")
			local hb = b.plr.Character and b.plr.Character:FindFirstChildOfClass("Humanoid")
			return (ha and ha.Health or 1e9) < (hb and hb.Health or 1e9)
		elseif mode == "Angle" then
			local cam = Workspace.CurrentCamera
			if cam then
				local sa = (cam.CFrame.LookVector:Dot((a.hrp.Position - cam.CFrame.Position).Unit))
				local sb = (cam.CFrame.LookVector:Dot((b.hrp.Position - cam.CFrame.Position).Unit))
				return sa > sb
			end
			return a.dist < b.dist
		end
		return a.dist < b.dist
	end)
	return out
end

local History = {}

local function recordHistory()
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local h = History[plr]
			if not h then
				h = {}
				History[plr] = h
			end
			table.insert(h, 1, { t = tick(), cf = hrp.CFrame })
			while #h > 60 do
				table.remove(h)
			end
		end
	end
end

local function backtrackPoint(hrp)
	if not Flags.Backtrack then
		return hrp.Position
	end
	local plr = Players:GetPlayerFromCharacter(hrp.Parent)
	local h = plr and History[plr]
	if h then
		local want = tick() - (Flags.BacktrackMs or 120) / 1000
		for _, snap in ipairs(h) do
			if snap.t <= want then
				return snap.cf.Position
			end
		end
	end
	return hrp.Position
end

local function aimPoint(hrp)
	local head = hrp.Parent:FindFirstChild("Head")
	local base = head and head.Position or hrp.Position
	if Flags.Backtrack then
		base = backtrackPoint(hrp) + Vector3.new(0, 1.5, 0)
	end
	return base + Vector3.new(0, Flags.AimOffset or 0, 0)
end

---------------------------------------------------------------------
--  input simulation
---------------------------------------------------------------------
local function click()
	local m1c = rawget(getfenv(0), "mouse1click")
	if type(m1c) == "function" then
		safe(m1c)
		return
	end
	safe(function()
		VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end)
end

local function pressKey(key, dur)
	dur = dur or 0.05
	safe(function()
		local kp = rawget(getfenv(0), "keypress")
		local kr = rawget(getfenv(0), "keyrelease")
		if type(kp) == "function" and type(kr) == "function" then
			kp(tostring(key))
			task.wait(dur)
			kr(tostring(key))
		else
			VIM:SendKeyEvent(true, key, false, game)
			task.wait(dur)
			VIM:SendKeyEvent(false, key, false, game)
		end
	end)
end

local function activateTool()
	local char = LocalPlayer.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	if tool then safe(function() tool:Activate() end) end
end

