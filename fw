	}, content)
	padding(page, 4)
	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, page)
	pages[name] = page
	return page
end

local function switchTab(name)
	for n, p in pairs(pages) do
		p.Visible = (n == name)
	end
	for n, b in pairs(pageButtons) do
		local on = (n == name)
		local t = Themes[State.Theme]
		tween(b, {
			BackgroundColor3 = on and State.Accent or t.side,
			BackgroundTransparency = on and 0.82 or 1,
		}, 0.6)
		local lbl = b:FindFirstChildOfClass("TextLabel")
		if lbl then
			tween(lbl, { TextColor3 = on and State.Accent or t.sub }, 0.6)
		end
	end
	activePage = name
end

local function addTab(name, glyph)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Themes[State.Theme].side,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
	}, sideList)
	corner(b, 8)
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		Text = glyph .. "  " .. name,
		TextColor3 = Themes[State.Theme].sub,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = b,
	})
	b.MouseEnter:Connect(function()
		if activePage ~= name then
			tween(b, { BackgroundTransparency = 0.9, BackgroundColor3 = Themes[State.Theme].card }, 0.5)
		end
	end)
	b.MouseLeave:Connect(function()
		if activePage ~= name then
			tween(b, { BackgroundTransparency = 1 }, 0.5)
		end
	end)
	b.MouseButton1Click:Connect(function() switchTab(name) end)
	pageButtons[name] = b
	makePage(name)
	return pages[name]
end

