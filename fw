local World = { saved = {} }

local function setWorld()
	local L = Lighting
	if Flags.Fullbright then
		L.Ambient = Color3.new(1, 1, 1)
		L.OutdoorAmbient = Color3.new(1, 1, 1)
		L.Brightness = 2
		L.ClockTime = 12
		if L:FindFirstChildOfClass("Atmosphere") then
			L:FindFirstChildOfClass("Atmosphere").Density = 0
			L:FindFirstChildOfClass("Atmosphere").Haze = 0
		end
	else
		L.Ambient = World.saved.Ambient or L.Ambient
		L.OutdoorAmbient = World.saved.OutdoorAmbient or L.OutdoorAmbient
		L.Brightness = World.saved.Brightness or 2
	end
	if Flags.TimeChanger then
		L.ClockTime = Flags.TimeValue or 14
	elseif World.saved.ClockTime then
		L.ClockTime = World.saved.ClockTime
	end
	if Flags.Weather then
		local atm = L:FindFirstChildOfClass("Atmosphere")
		if atm then
			atm.Density = Flags.WeatherDensity or 0.3
			atm.Haze = Flags.WeatherDensity or 0.3
		end
	end
	if Flags.WorldColor then
		local cc = L:FindFirstChild("ollie_cc")
		if not cc then
			cc = new("ColorCorrectionEffect", { Name = "ollie_cc", Parent = L })
		end
		cc.TintColor = Flags.WorldTint or Color3.fromRGB(255, 255, 255)
		cc.Saturation = (Flags.WorldSat or 0)
		cc.Brightness = 0
	else
		local cc = L:FindFirstChild("ollie_cc")
		if cc then cc:Destroy() end
	end
end

local function saveWorld()
	local L = Lighting
	World.saved.Ambient = L.Ambient
	World.saved.OutdoorAmbient = L.OutdoorAmbient
	World.saved.Brightness = L.Brightness
	World.saved.ClockTime = L.ClockTime
end

saveWorld()

