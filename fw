-- heartbeat: engine
RunService.Heartbeat:Connect(function(dt)
	safe(function()
		fpsSmooth = fpsSmooth * 0.9 + (1 / math.max(dt, 1e-3)) * 0.1
		cpsWindow = cpsCount
		cpsCount = 0
		recordHistory()
		trackHits()
		if Flags.KillAura then runKillAura(dt) end
		if Flags.TriggerBot then runTriggerBot() end
		if Flags.AutoClicker then runAutoClicker() end
		if Flags.HitboxExpander then applyHitboxExpander() end
		applyReach()
		if Flags.TargetStrafe then runStrafe(dt) end
		if Flags.AutoBlock then runAutoBlock() end
		if Flags.AutoParry then runAutoParry() end
		if Flags.AutoCombo then runAutoCombo() end
		runVelocity()
		runMovement(dt)
		runVisuals()
		updateHud()
		updateTargetHud()
		handleSky()
		setWorld()
	end)
end)

