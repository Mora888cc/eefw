local ESP = { entries = {}, highlights = {} }

local function newDrawing(kind)
	if not Draw then return nil end
	local ok, obj = pcall(function() return Draw.new(kind) end)
	if ok then return obj end
	return nil
end

local function getEntry(plr)
	local e = ESP.entries[plr]
	if e then return e end
	e = {
		box = newDrawing("Square"),
		boxOutline = newDrawing("Square"),
		name = newDrawing("Text"),
		healthBg = newDrawing("Square"),
		health = newDrawing("Square"),
		tracer = newDrawing("Line"),
	}
	ESP.entries[plr] = e
	return e
end

local function destroyEntry(plr)
	local e = ESP.entries[plr]
	if not e then return end
	for key, d in pairs(e) do
		if key ~= "skel" and d then
			safe(function() d:Remove() end)
		end
	end
	if e.skel then
		for _, line in ipairs(e.skel) do
			if line then safe(function() line:Remove() end) end
		end
	end
	ESP.entries[plr] = nil
end

local function charBounds(char)
	local parts = {}
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			table.insert(parts, part)
		end
	end
	if #parts == 0 then return nil end
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, p in ipairs(parts) do
		local top = cam:WorldToViewportPoint(p.Position + Vector3.new(0, p.Size.Y / 2, 0))
		local bot = cam:WorldToViewportPoint(p.Position - Vector3.new(0, p.Size.Y / 2, 0))
		if top.Z > 0 and bot.Z > 0 then
			minX = math.min(minX, top.X)
			maxX = math.max(maxX, top.X)
			minY = math.min(minY, top.Y)
			maxY = math.max(maxY, bot.Y)
		end
	end
	if minX == math.huge then return nil end
	return minX, minY, maxX, maxY
end

local function updateESP(plr)
	local entry = ESP.entries[plr]
	if not entry then return end
	local char = plr.Character
	local visible = Flags.ESPEnabled
		and char
		and plr ~= LocalPlayer
		and not (Flags.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team)
		and not Friends[plr]
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not visible or not hum or hum.Health <= 0 then
		for _, d in pairs(entry) do
			if d then safe(function() d.Visible = false end) end
		end
		return
	end
	local x1, y1, x2, y2 = charBounds(char)
	if not x1 then
		for _, d in pairs(entry) do
			if d then safe(function() d.Visible = false end) end
		end
		return
	end
	local col = Flags.ESPColor or Color3.fromRGB(255, 90, 120)
	local h, w = y2 - y1, x2 - x1
	local pad = 3
	local cam = Workspace.CurrentCamera
	if entry.box then
		entry.box.Visible = Flags.ESPBox
		entry.box.Color = col
		entry.box.Thickness = 1
		entry.box.From = Vector2.new(x1 - pad, y1 - pad)
		entry.box.To = Vector2.new(x2 + pad, y2 + pad)
	end
	if entry.boxOutline then
		entry.boxOutline.Visible = Flags.ESPBox
		entry.boxOutline.Color = Color3.new(0, 0, 0)
		entry.boxOutline.Thickness = 1
		entry.boxOutline.From = Vector2.new(x1 - pad - 1, y1 - pad - 1)
		entry.boxOutline.To = Vector2.new(x2 + pad + 1, y2 + pad + 1)
	end
	if entry.name then
		entry.name.Visible = Flags.ESPName
		entry.name.Color = col
		entry.name.Size = 13
		entry.name.Center = true
		entry.name.Outline = true
		entry.name.Text = string.format("%s [%d]", plr.Name, math.floor(hum.Health))
		entry.name.Position = Vector2.new((x1 + x2) / 2, y1 - 16)
	end
	if entry.healthBg and entry.health then
		entry.healthBg.Visible = Flags.ESPHealth
		entry.health.Visible = Flags.ESPHealth
		entry.healthBg.Color = Color3.new(0, 0, 0)
		entry.healthBg.Filled = true
		entry.healthBg.From = Vector2.new(x1 - 8, y1)
		entry.healthBg.To = Vector2.new(x1 - 3, y2)
		entry.health.Color = Color3.fromRGB(90, 230, 130)
		entry.health.Filled = true
		local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		entry.health.From = Vector2.new(x1 - 8, y2 - h * frac)
		entry.health.To = Vector2.new(x1 - 3, y2)
	end
	if entry.tracer and cam then
		entry.tracer.Visible = Flags.ESPTracer
		local vp = cam.ViewportSize
		local bottom = cam:WorldToViewportPoint((char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")).Position)
		entry.tracer.Color = col
		entry.tracer.Thickness = 1
		entry.tracer.From = Vector2.new(vp.X / 2, vp.Y)
		entry.tracer.To = Vector2.new(bottom.X, bottom.Y)
	end
end

local SKELETON = {
	{ "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" },
	{ "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" },
	{ "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" },
	{ "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" },
	{ "RightLowerLeg", "RightFoot" },
}

local function updateSkeleton(plr)
	local entry = getEntry(plr)
	entry.skel = entry.skel or {}
	local cam = Workspace.CurrentCamera
	local char = plr.Character
	local want = Flags.ESPSkeleton and Flags.ESPEnabled and char and cam
	for i = 1, #SKELETON do
		if not entry.skel[i] then
			entry.skel[i] = newDrawing("Line")
		end
		local line = entry.skel[i]
		local a = char and char:FindFirstChild(SKELETON[i][1])
		local b = char and char:FindFirstChild(SKELETON[i][2])
		if line then
			if want and a and b then
				local pa = cam:WorldToViewportPoint(a.Position)
				local pb = cam:WorldToViewportPoint(b.Position)
				line.Visible = pa.Z > 0 and pb.Z > 0
				line.From = Vector2.new(pa.X, pa.Y)
				line.To = Vector2.new(pb.X, pb.Y)
				line.Color = Flags.ESPColor or Color3.fromRGB(255, 90, 120)
				line.Thickness = 1
			else
				line.Visible = false
			end
		end
	end
	if not want and entry.skel then
		for _, line in ipairs(entry.skel) do
			if line then safe(function() line.Visible = false end) end
		end
	end
end

local function updateChams(plr)
	local key = plr
	if Flags.ESPChams and plr ~= LocalPlayer and plr.Character then
		local hl = ESP.highlights[key]
		if not hl then
			hl = new("Highlight", {
				FillColor = Flags.ESPColor or Color3.fromRGB(255, 90, 120),
				FillTransparency = 0.55,
				OutlineColor = Color3.new(1, 1, 1),
				OutlineTransparency = 1,
				Parent = plr.Character,
			})
			ESP.highlights[key] = hl
		else
			hl.FillColor = Flags.ESPColor or Color3.fromRGB(255, 90, 120)
			hl.FillTransparency = 0.55
			if hl.Parent ~= plr.Character then hl.Parent = plr.Character end
		end
	else
		local hl = ESP.highlights[key]
		if hl then safe(function() hl:Destroy() end); ESP.highlights[key] = nil end
	end
end

local function runVisuals()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if Draw then
				updateESP(plr)
				updateSkeleton(plr)
			end
			updateChams(plr)
		end
	end
	for plr in pairs(ESP.entries) do
		if not plr.Parent then destroyEntry(plr) end
	end
end

