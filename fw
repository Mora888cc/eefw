	ESPColor = true, WorldTint = true,
}

local function serialize()
	local out = { flags = {}, state = {}, binds = {}, friends = {}, enemies = {} }
	for k, v in pairs(Flags) do
		if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
			out.flags[k] = v
		elseif typeof(v) == "Color3" then
			out.flags[k] = { __color = true, r = v.R, g = v.G, b = v.B }
		end
	end
	out.state = {
		Theme = State.Theme,
		Accent = { r = State.Accent.R, g = State.Accent.G, b = State.Accent.B },
		Scale = State.Scale,
		AnimSpeed = State.AnimSpeed,
		Priority = State.Priority,
	}
	for k, v in pairs(Binds) do
		if typeof(v) == "EnumItem" then out.binds[k] = v.Name end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if Friends[plr] then table.insert(out.friends, plr.Name) end
		if Enemies[plr] then table.insert(out.enemies, plr.Name) end
	end
	return HttpService:JSONEncode(out)
end

local function deserialize(data)
	if type(data) ~= "table" then return end
	if type(data.flags) == "table" then
		for k, v in pairs(data.flags) do
			if type(v) == "table" and v.__color then
				setFlag(k, Color3.new(v.r, v.g, v.b))
			else
				setFlag(k, v)
			end
		end
	end
	if type(data.state) == "table" then
		if data.state.Theme then State.Theme = data.state.Theme end
		if type(data.state.Accent) == "table" then
			State.Accent = Color3.new(data.state.Accent.r, data.state.Accent.g, data.state.Accent.b)
		end
		if data.state.Scale then
			State.Scale = data.state.Scale
			uiScale.Scale = State.Scale * viewportScale()
		end
		if data.state.AnimSpeed then State.AnimSpeed = data.state.AnimSpeed end
		if data.state.Priority then State.Priority = data.state.Priority end
		refreshPriority()
		applyTheme()
	end
	if type(data.binds) == "table" then
		for k, v in pairs(data.binds) do
			local ok, code = pcall(function() return Enum.KeyCode[v] end)
			if ok and code then Binds[k] = code end
		end
	end
	if type(data.friends) == "table" then
		for _, name in ipairs(data.friends) do
			local plr = Players:FindFirstChild(name)
			if plr then Friends[plr] = true end
		end
	end
	if type(data.enemies) == "table" then
		for _, name in ipairs(data.enemies) do
			local plr = Players:FindFirstChild(name)
			if plr then Enemies[plr] = true end
		end
	end
	refreshPriority()
	-- modules that hold live instances (fly bodies, hitbox parts) need the callback
	for k, cb in pairs(FlagCb) do
		if type(cb) == "function" and Flags[k] ~= nil then
			safe(cb, Flags[k])
		end
	end
end

local function saveConfig(silent)
	ensureDir()
	if type(writefile) ~= "function" then
		notify("config", "executor has no writefile", Color3.fromRGB(230, 120, 90))
		return false
	end
	local ok = pcall(writefile, CONFIG_FILE, serialize())
	if not silent then
		notify("config", ok and "saved" or "save failed", ok and State.Accent or Color3.fromRGB(230, 120, 90))
	end
	return ok
end

local function loadConfig(silent)
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		notify("config", "executor has no file io", Color3.fromRGB(230, 120, 90))
		return false
	end
	if not isfile(CONFIG_FILE) then
		if not silent then notify("config", "no config on disk", Color3.fromRGB(230, 120, 90)) end
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(CONFIG_FILE))
	end)
	if not ok then
		if not silent then notify("config", "corrupt config", Color3.fromRGB(230, 120, 90)) end
		return false
	end
	deserialize(data)
	if not silent then notify("config", "loaded", State.Accent) end
	return true
end

