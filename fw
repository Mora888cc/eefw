		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = c,
	})

	local state = false
	local function render(on, animate)
		state = on
		local trackColor = on and State.Accent or Themes[State.Theme].stroke
		local knobPos = on and UDim2.new(1, -14, 0, 2) or UDim2.new(0, 2, 0, 2)
		if animate == false then
			track.BackgroundColor3 = trackColor
			knob.Position = knobPos
		else
			tween(track, { BackgroundColor3 = trackColor }, 0.7)
			tween(knob, { Position = knobPos }, 0.7)
		end
	end

	SetterOf[flag] = function(v, internal)
		if v ~= state then
			render(v, true)
			Flags[flag] = v
