---------------------------------------------------------------------
--  combat engine
---------------------------------------------------------------------
local Combat = {
	lastClick = 0,
	lastStrafe = 0,
	strafeDir = 1,
	lastBlock = 0,
	lastCombo = 0,
	comboStep = 0,
	parryUntil = 0,
	lastHealth = nil,
}

local function scheduleAttack(dt)
	local now = tick()
	local cd = 1 / math.max(Flags.AuraCPS or 12, 0.5)
	if now - Combat.lastClick < cd then return end
	Combat.lastClick = now
	if Flags.Criticals then
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum:GetState() == Enum.HumanoidStateType.Landed then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	activateTool()
	click()
end

local function runKillAura(dt)
	local range = Flags.AuraRange or 20
	local targets = getTargets(range)
	if #targets == 0 then return end
	if Flags.MultiAura then
		for _, t in ipairs(targets) do
			local _ = t
			activateTool()
		end
	end
	scheduleAttack(dt)
end

local function runAimAura(dt)
	if not Flags.AimAura then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local targets = getTargets(Flags.AimRange or 120)
	local t = targets[1]
	if not t then return end
	local aim = aimPoint(t.hrp)
	local desired = CFrame.lookAt(cam.CFrame.Position, aim)
	local alpha = math.clamp((Flags.AimSmooth or 0.15) * dt * 30, 0, 1)
	cam.CFrame = cam.CFrame:Lerp(desired, alpha)
end

local function runTriggerBot()
	if not Flags.TriggerBot then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local targets = getTargets(Flags.AuraRange or 20)
	local best
	for _, t in ipairs(targets) do
		local sp = cam:WorldToViewportPoint(aimPoint(t.hrp))
		if sp.Z > 0 then
			local vp = cam.ViewportSize
			local dx = sp.X - vp.X / 2
			local dy = sp.Y - vp.Y / 2
			if math.sqrt(dx * dx + dy * dy) <= (Flags.TriggerFOV or 60) then
				best = t
				break
			end
		end
	end
	if best then
		click()
		if Flags.Criticals then
			local _, hum = getChar()
			if hum and hum:GetState() == Enum.HumanoidStateType.Landed then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end
end

local function runAutoClicker()
	if not Flags.AutoClicker then return end
	local now = tick()
	local interval = 1 / math.max(Flags.ClickerCPS or 15, 1)
	if now - (Combat.lastAutoClick or 0) >= interval then
		Combat.lastAutoClick = now
		click()
	end
end

local function applyHitboxExpander()
	local size = Flags.HitboxSize or 8
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local head = plr.Character:FindFirstChild("Head")
			if head then
				local box = head:FindFirstChild("ollie_hitbox")
				if Flags.HitboxExpander then
					if not box then
						box = new("Part", {
							Name = "ollie_hitbox",
							Size = Vector3.new(size, size, size),
							CanCollide = false,
							CanQuery = true,
							CanTouch = true,
							Massless = true,
							Transparency = 1,
							Parent = head,
						})
						new("WeldConstraint", { Part0 = head, Part1 = box }, box)
					else
						box.Size = Vector3.new(size, size, size)
					end
				elseif box then
					box:Destroy()
				end
			end
		end
	end
end

local function applyReach()
	local char, hum, hrp = getChar()
	if not hrp then return end
	local part = hrp:FindFirstChild("ollie_reach")
	if Flags.ReachEnabled then
		local size = Flags.ReachRange or 12
		if not part then
			part = new("Part", {
				Name = "ollie_reach",
				Size = Vector3.new(size, size, size),
				CanCollide = false,
				CanQuery = false,
				CanTouch = true,
				Massless = true,
				Transparency = 1,
				Parent = hrp,
			})
			new("WeldConstraint", { Part0 = hrp, Part1 = part }, part)
		else
			part.Size = Vector3.new(size, size, size)
		end
	elseif part then
		part:Destroy()
	end
end

local function runStrafe(dt)
	if not Flags.TargetStrafe then return end
	local _, hum, hrp = getChar()
	if not hum or not hrp then return end
	local targets = getTargets(Flags.AuraRange or 20)
	local t = targets[1]
	if not t then return end
	local toTarget = (t.hrp.Position - hrp.Position)
	toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
	if toTarget.Magnitude < 1e-3 then return end
	local unit = toTarget.Unit
	local side = Vector3.new(-unit.Z, 0, unit.X) * Combat.strafeDir
	if tick() - Combat.lastStrafe > (Flags.StrafeSwitch or 0.8) then
		Combat.lastStrafe = tick()
		Combat.strafeDir = -Combat.strafeDir
	end
	hum:Move((side * 0.9 + unit * 0.25), false)
end

local function runAutoBlock()
	if not Flags.AutoBlock then return end
	if tick() - Combat.lastBlock < (Flags.BlockInterval or 0.35) then return end
	Combat.lastBlock = tick()
	pressKey(Flags.BlockKeyCode or Enum.KeyCode.F, 0.08)
end

local function runAutoParry()
	if not Flags.AutoParry then return end
	local _, hum = getChar()
	if not hum then return end
	if Combat.lastHealth == nil then
		Combat.lastHealth = hum.Health
		return
	end
	if hum.Health < Combat.lastHealth - 0.1 then
		Combat.parryUntil = tick() + (Flags.ParryWindow or 0.25)
	end
	Combat.lastHealth = hum.Health
	if tick() <= Combat.parryUntil then
		pressKey(Flags.ParryKeyCode or Enum.KeyCode.F, 0.06)
		Combat.parryUntil = 0
	end
end

local function runAutoCombo()
	if not Flags.AutoCombo then return end
	local seq = { Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.R, Enum.KeyCode.F }
	local delay = Flags.ComboDelay or 0.35
	if tick() - Combat.lastCombo < delay then return end
	Combat.lastCombo = tick()
	Combat.comboStep = (Combat.comboStep % #seq) + 1
	pressKey(seq[Combat.comboStep], 0.05)
end

local function runVelocity()
	local _, hum, hrp = getChar()
	if not hrp then return end
	if Flags.Velocity then
		local v = hrp.AssemblyLinearVelocity
		local cap = Flags.VelocityCap or 18
		local flat = Vector3.new(v.X, 0, v.Z)
		if flat.Magnitude > cap then
			local clamped = flat.Unit * cap
			hrp.AssemblyLinearVelocity = Vector3.new(clamped.X, v.Y, clamped.Z)
		end
	end
	if Flags.AntiKnockback and hum then
		local v = hrp.AssemblyLinearVelocity
		local flat = Vector3.new(v.X, 0, v.Z)
		local limit = math.max((hum.WalkSpeed or 16) + 4, 12)
		if flat.Magnitude > limit then
			local k = limit / flat.Magnitude
			hrp.AssemblyLinearVelocity = Vector3.new(v.X * k, math.max(v.Y, 0), v.Z * k)
		end
	end
end

