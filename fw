		TextColor3 = State.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = c,
	})
	themed(val, "TextColor3", "accent")

	local track = new("Frame", {
		Size = UDim2.new(1, -24, 0, 4),
		Position = UDim2.new(0, 12, 0, 30),
		BackgroundColor3 = Themes[State.Theme].stroke,
		BorderSizePixel = 0,
	}, c)
	corner(track, 2)
	themed(track, "BackgroundColor3", "stroke")
	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = State.Accent,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 2)
	themed(fill, "BackgroundColor3", "accent")
	local knob = new("Frame", {
		Size = UDim2.new(0, 10, 0, 10),
		Position = UDim2.new(0, 0, 0.5, -5),
		BackgroundColor3 = Color3.fromRGB(245, 245, 250),
		BorderSizePixel = 0,
		ZIndex = 4,
	}, track)
	corner(knob, 5)

	local value = default
	local function apply(v, doCb)
		value = math.clamp(v, min, max)
		local a = (value - min) / math.max(max - min, 1e-6)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, -5, 0.5, -5)
		val.Text = tostring(rnd(value * 100) / 100) .. (suffix or "")
		Flags[flag] = value
		if doCb and type(cb) == "function" then safe(cb, value) end
	end

	SetterOf[flag] = function(v, internal)
		apply(v, not internal)
	end

	local dragging = false
	local function fromX(x)
		local abs = track.AbsolutePosition
		local size = track.AbsoluteSize.X
		local a = math.clamp((x - abs.X) / math.max(size, 1), 0, 1)
		apply(min + (max - min) * a, true)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	track.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			fromX(input.Position.X)
		end
	end)

	apply(default, false)
	return c
end

