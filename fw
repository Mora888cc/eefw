local cpsCount, cpsWindow = 0, 0
local hits = 0
local lastTargetHealth = {}
local fpsSmooth = 60

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		cpsCount = cpsCount + 1
	end
	-- binds
	for action, code in pairs(Binds) do
		if input.KeyCode == code and action ~= "toggleui" then
			if action == "blockkey" then
				Flags.BlockKeyCode = code
			elseif action == "parrykey" then
				Flags.ParryKeyCode = code
			else
				local fb = SetterOf[action]
				if fb then
					local nv = not Flags[action]
					fb(nv)
					Flags[action] = nv
				end
			end
		end
	end
	if input.KeyCode == (Binds.toggleui or Enum.KeyCode.RightShift) then
		State.Open = not State.Open
		main.Visible = State.Open
		shadow.Visible = State.Open and not State.Minimized
		if State.Open then
			notify("window", "opened", State.Accent)
		end
	end
end)

local function updateHud()
	local _, hum, hrp = getChar()
	if Flags.PlayerInfo then
		infoFrame.Visible = true
		infoName.Text = tostring(LocalPlayer.Name)
		if hum then
			infoBody.Text = string.format(
				"health  %d / %d\nspeed   %d\nstate   %s",
				math.floor(hum.Health), math.floor(hum.MaxHealth),
				math.floor(hum.WalkSpeed),
				tostring(hum:GetState()):gsub("Enum.HumanoidStateType.", "")
			)
		end
	else
		infoFrame.Visible = false
	end
	cpsFrame.Visible = Flags.CPS or Flags.HitCounter
	if cpsFrame.Visible then
		cpsLabel.Text = string.format("cps %d | hit %d", cpsWindow, hits)
	end
	statFrame.Visible = Flags.FPS or Flags.Ping or Flags.Coords
	fpsLabel.Visible = Flags.FPS
	pingLabel.Visible = Flags.Ping
	coordLabel.Visible = Flags.Coords
	if hrp and Flags.Coords then
		coordLabel.Text = string.format("%d,%d,%d", rnd(hrp.Position.X), rnd(hrp.Position.Y), rnd(hrp.Position.Z))
	end
	keyHolder.Visible = Flags.Keystrokes
	for code, box in pairs(keyBoxes) do
		box.frame.Visible = Flags.Keystrokes
	end
end

local function updateTargetHud()
	if not Flags.TargetHUD then
		targetHud.Visible = false
		return
	end
	local targets = getTargets(Flags.AuraRange or 60)
	local t = targets[1]
	if not t then
		targetHud.Visible = false
		return
	end
	local hum = t.plr.Character and t.plr.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	targetHud.Visible = true
	thName.Text = t.plr.Name
	local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
	thBar.Size = UDim2.new(frac, 0, 1, 0)
	thBar.BackgroundColor3 = State.Accent
	thInfo.Text = string.format("%d hp - %d studs", math.floor(hum.Health), math.floor(t.dist))
end

local function trackHits()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				local prev = lastTargetHealth[plr]
				if prev and hum.Health < prev then
					hits = hits + 1
				end
				lastTargetHealth[plr] = hum.Health
			end
		end
	end
end

local function handleSky()
	local L = Lighting
	if Flags.CustomSky then
		local id = tonumber(tostring(Flags.SkyId or ""):match("%d+") or "")
		if id then
			local sky = L:FindFirstChild("ollie_sky")
			if not sky then
				sky = new("Sky", { Name = "ollie_sky", Parent = L })
			end
			sky.SkyboxBk = "rbxassetid://" .. id
			sky.SkyboxDn = "rbxassetid://" .. id
			sky.SkyboxFt = "rbxassetid://" .. id
			sky.SkyboxLf = "rbxassetid://" .. id
			sky.SkyboxRt = "rbxassetid://" .. id
			sky.SkyboxUp = "rbxassetid://" .. id
		end
	else
		local sky = L:FindFirstChild("ollie_sky")
		if sky then sky:Destroy() end
	end
end

