--  movement engine
---------------------------------------------------------------------
local Movement = {
	flyBV = nil,
	flyBG = nil,
	lastJump = 0,
	lastHop = 0,
	lastSpider = 0,
}

local function setFly(on)
	local char, hum, hrp = getChar()
	if not hrp then return end
	if on then
		if not Movement.flyBV then
			Movement.flyBV = new("BodyVelocity", {
				MaxForce = Vector3.new(1e9, 1e9, 1e9),
				P = 1250,
				Velocity = Vector3.new(0, 0, 0),
				Parent = hrp,
			})
			Movement.flyBG = new("BodyGyro", {
				MaxTorque = Vector3.new(1e9, 1e9, 1e9),
				P = 1250,
				D = 50,
				CFrame = hrp.CFrame,
				Parent = hrp,
			})
		end
	else
		if Movement.flyBV then Movement.flyBV:Destroy(); Movement.flyBV = nil end
		if Movement.flyBG then Movement.flyBG:Destroy(); Movement.flyBG = nil end
	end
end

local function runFly(dt)
	if not Flags.Fly then
		if Movement.flyBV then setFly(false) end
		return
	end
	local char, hum, hrp = getChar()
	if not hrp then
		setFly(false)
		return
	end
	if not Movement.flyBV then setFly(true) end
	if not Movement.flyBV then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local dir = Vector3.new(0, 0, 0)
	local right = cam.CFrame.RightVector
	local look = cam.CFrame.LookVector
	if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
	if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
	if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
	if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
	if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
	local speed = Flags.FlySpeed or 60
	Movement.flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.new(0, 0, 0)
end

local function runSpeed()
	local _, hum = getChar()
	if not hum then return end
	if Flags.Speed then
		hum.WalkSpeed = Flags.SpeedValue or 32
	elseif Flags.NoSlow then
		hum.WalkSpeed = Flags.SpeedValue or 32
	elseif Flags.AutoSprint and hum.MoveDirection.Magnitude > 0.1 then
		hum.WalkSpeed = Flags.SprintValue or 28
	end
end

local function runLongJump()
	if not Flags.LongJump then return end
	if not UIS:IsKeyDown(Enum.KeyCode.Space) then return end
	local _, hum, hrp = getChar()
	if not hrp then return end
	if tick() - Movement.lastJump < 0.12 then return end
	local state = hum:GetState()
	if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then
		return
	end
	Movement.lastJump = tick()
	local moveDir = hum.MoveDirection
	if moveDir.Magnitude < 0.1 then
		local cam = Workspace.CurrentCamera
		if cam then moveDir = cam.CFrame.LookVector end
	end
	local flat = Vector3.new(moveDir.X, 0, moveDir.Z)
	if flat.Magnitude < 1e-3 then return end
	hrp.AssemblyLinearVelocity = flat.Unit * (Flags.LongJumpPower or 90) + Vector3.new(0, 42, 0)
end

local function runHighJump()
	local _, hum = getChar()
	if not hum then return end
	if Flags.HighJump then
		hum.UseJumpPower = true
		hum.JumpPower = Flags.JumpPower or 80
	end
end

local function runBunnyHop()
	if not Flags.BunnyHop then return end
	local _, hum = getChar()
	if not hum then return end
	if hum.MoveDirection.Magnitude < 0.1 then return end
	local state = hum:GetState()
	if state == Enum.HumanoidStateType.Landed or state == Enum.HumanoidStateType.Running then
		if tick() - Movement.lastHop > 0.08 then
			Movement.lastHop = tick()
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end

local function runSpider()
	if not Flags.Spider then return end
	local _, hum, hrp = getChar()
	if not hrp then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	local result = Workspace:Raycast(hrp.Position, cam.CFrame.LookVector * 3, params)
	if result then
		if tick() - Movement.lastSpider > 0.05 then
			Movement.lastSpider = tick()
			local v = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(v.X, (Flags.SpiderSpeed or 40), v.Z)
		end
	end
end

local function runMovement(dt)
	runFly(dt)
	runSpeed()
	runHighJump()
	runLongJump()
	runBunnyHop()
	runSpider()
end

